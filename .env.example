# Supabase（未設定でも起動する。未設定のあいだ視聴記録は端末内=localStorage に保存）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# フェーズ1の開発用受講（supabase/seed.sql が作る enrollment を指す）
DEV_ENROLLMENT_ID=55555555-5555-5555-5555-555555555555

# 音声mp3の置き場所（Storage の公開URL。未設定なら Web Speech API で読み上げ）
# 例: https://xxxx.supabase.co/storage/v1/object/public/audio
NEXT_PUBLIC_AUDIO_BASE=
