# Supabase（未設定でも起動する。未設定のあいだ視聴記録は端末内=localStorage に保存）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# フェーズ1の開発用受講（supabase/seed.sql が作る enrollment を指す）
DEV_ENROLLMENT_ID=55555555-5555-5555-5555-555555555555

# 修了試験トークンの署名鍵（本番では必ず設定。未設定時は開発用の固定値）
EXAM_SECRET=

# 音声mp3の置き場所（Storage の公開URL。未設定なら Web Speech API で読み上げ）
# 例: https://xxxx.supabase.co/storage/v1/object/public/audio
NEXT_PUBLIC_AUDIO_BASE=

# ── LINE（店ごとに違う値。NEXT_PUBLIC_ を付けないこと）──
# 申込が来たことを運営に知らせる（Messaging API の push）
LINE_TOKEN=
LINE_TO=
# LINE でログインする（LINE Developers のログインチャネル）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# 公式アカウント（Messaging API チャネル）の鍵。
#   TOKEN  … リッチメニューを配る／本人に知らせを送る
#   SECRET … LINE から届いたものが本物か確かめる（Webhook）
LINE_MENU_TOKEN=
LINE_BOT_SECRET=

# ── お金（2026-09-11 に足した。入れ忘れると /setup に赤で出る）──
# 運営管理を開ける人のメール（カンマ区切り）。0人だと入金の確認ができない
OWNER_EMAILS=
# 講座の単価（税抜）。無くても src/lib/pricing.ts の値で売れる。講座ごとは SEAT_UNIT_PRICE_<講座id>
SEAT_UNIT_PRICE=
# 実務トレーニング（第2章から先）の単価（税抜）。無ければ足場の席と同じ
TRAIN_UNIT_PRICE=
# カード払い。無ければ請求書払いだけで売る（特商法の表記も自動で切り替わる）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 本番の住所（https://…、末尾の / なし）。支払い後と合言葉の決め直しの戻り先
SITE_URL=
NEXT_PUBLIC_SITE_URL=

# ── 修了証の名義（刷って配るもの。秘密ではない）──
CERT_ISSUER_NAME=
CERT_ISSUER_RESPONSIBLE=

# ── どちらの店か（書かなければ足場屋革命）。tokubetsu で特別教育ドットコム ──
NEXT_PUBLIC_BRAND=
